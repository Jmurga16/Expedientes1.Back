# Copiar a .env y completar. .env NO se commitea.
# En Azure App Service cargar las mismas claves en Configuration > Application settings.

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=db_expedientes

# JWT - Base64URL de al menos 32 bytes. Generar con:
#   openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
JWT_SECRET=<secreto-base64url>
# segundos (36000 = 10 h)
JWT_EXPIRATION=36000

# CORS - origenes del front separados por coma (default: localhost:4200 y gestor-expedientesv1)
# CORS_ALLOWED_ORIGINS=http://localhost:4200

# Rate limit de login (opcionales, valores por defecto entre parentesis)
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=300
# LOGIN_BLOCK_SECONDS=900

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=<cuenta>
AZURE_STORAGE_ACCOUNT_KEY=<access-key>

# Seed (solo perfil "seed"): mvn spring-boot:run -Dspring-boot.run.profiles=seed
# true = borra y recarga area, tipologia, subtipologia, workflow y users
SEED_RESET=false
